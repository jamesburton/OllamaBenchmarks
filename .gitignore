# .NET coding-template build artifacts (regenerable). NuGet *restore* files under
# obj/ are tracked intentionally for some templates; build outputs are not. The
# per-run restored copies under templates/.cache/ are regenerated by setup_template_cache.
scripts/coding_tasks/templates/*/obj/Debug/
scripts/coding_tasks/templates/*/obj/Release/
scripts/coding_tasks/templates/.cache/
