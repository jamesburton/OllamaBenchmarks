<?xml version="1.0" encoding="utf-8"?>
<!-- Clear inherited sources and use only nuget.org, bypassing the machine private
     fnz-qhub feed (401 here) that can break restore. See test_project/nuget.config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
