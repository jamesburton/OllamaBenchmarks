<?xml version="1.0" encoding="utf-8"?>
<!-- Clear inherited sources and use only nuget.org. The machine/user NuGet.config
     points at a private fnz-qhub feed (QHubPackages) that returns 401 here; combined
     with packages being evicted from the global cache, that made no-restore builds
     fail (NETSDK1064) for this template, which silently zeroed out the test_project
     half of Layer 3 (all builds failed regardless of model). The clear element below
     isolates restore from the private feed so packages resolve from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
