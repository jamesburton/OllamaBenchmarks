<?xml version="1.0" encoding="utf-8"?>
<!-- Clear inherited sources and use only nuget.org. The machine/user NuGet.config
     points at a private fnz-qhub feed (QHubPackages) that returns 401 here, which
     breaks restore for this sandbox; <clear/> isolates us from it. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
